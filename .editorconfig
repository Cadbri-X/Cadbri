# EditorConfig helps maintain consistent coding styles across editors
# https://editorconfig.org/

root = true

# Global defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source code (follows standard gofmt conventions)
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# Frontend TypeScript, JavaScript & Web files
[*.{ts,tsx,js,jsx,mjs,cjs,html,css,svg}]
indent_style = space
indent_size = 2

# Data serialization and configuration formats
[*.{json,json5,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Markdown documentation (preserve trailing whitespace for line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# Docker & Nginx configurations
[{Dockerfile*,*.dockerfile,nginx*.conf}]
indent_style = space
indent_size = 4

# Minified and vendor assets
[*.{min.js,min.css}]
indent_style = ignore
insert_final_newline = ignore
trim_trailing_whitespace = false
